APP_NAME=engine
APP_ENV=prod

GRPC_PORT=50051

DATABASE_URL=postgresql://postgres:postgres@pgbouncer:6432/engine
DATABASE_DIRECT_URL=postgresql://postgres:postgres@postgres:5432/engine

ACCESS_SECRET=your_access_secret

PG_BOSS_MAX=5
PG_BOSS_MAINTENANCE_INTERVAL_SECONDS=60
PG_BOSS_APPLICATION_NAME=engine-pg-boss

KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=engine-client
KAFKA_GROUP_ID=engine-service

MESSAGE_CONSUMER_TOPIC_MATCHMAKING_MATCHED=matchmaking.matched
MESSAGE_PRODUCER_TOPIC_BATTLE_UPDATED=engine.battle_updated
MESSAGE_PRODUCER_TOPIC_BATTLE_STARTED=engine.battle_started
MESSAGE_PRODUCER_TOPIC_BATTLE_TERMINATED=engine.battle_terminated

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=supersecret

BATTLE_TURN_TIME_LIMIT=21
BATTLE_START_TIME_LIMIT=5
